# Build artifacts
.next/
out/

# Dependencies (reinstalled inside Docker)
node_modules/
packages/*/node_modules/

# Version control
.git/
.gitignore

# Tests & docs (not needed for production build)
tests/
# This config imports its journey list from tests/. `next build` type-checks
# every root TypeScript file, so leaving it in the context fails the image build.
playwright.export.config.ts
docs/
coverage/
test_output.txt

# Environment & secrets. `**/` reaches nested files such as docker/.env, where
# the docs put the at-rest encryption key (SEC-027).
**/.env
**/.env.*
.build-env.sh
.build-info.json
.npmrc
bunfig.toml

# Certificates & keys (never copy into build context)
*.pem
*.key
*.crt
*.p12
*.pfx
*.cert
certs/
docker/certs/

# Editor & OS files
.vscode/
.idea/
*.swp
.DS_Store

# Other sensitive / unnecessary files
*.secret
*.secrets
credentials*
.terraform/
*.tfstate*
sonar-project.properties

# Every root dot-entry: agent and tool folders (.kiro/, .claude/, .codex/, and
# whatever comes next), .mcp.json, and .next-cache/. The build needs none of
# them. Root only: `public/.well-known/` must stay in the context.
.*
