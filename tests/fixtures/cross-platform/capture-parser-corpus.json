          "t3",
          "t4",
          "t5",
          "t6",
          "t7",
          "t8",
          "t9",
          "t10",
          "t11",
          "t12",
          "t13",
          "t14",
          "t15",
          "t16",
          "t17",
          "t18",
          "t19",
          "t20"
        ],
        "urls": []
      }
    },
    {
      "name": "hash inside a word is not a tag",
      "input": "price#tag stays",
      "expect": {
        "title": "price#tag stays",
        "urgent": false,
        "important": false,
        "tags": [],
        "urls": []
      }
    },
    {
      "name": "tag before punctuation keeps the punctuation",
