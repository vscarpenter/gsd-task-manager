{
	"name": "gsd-taskmanager",
	"version": "12.2.0",
	"packageManager": "bun@1.3.14",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "next dev",
		"dev:e2e": "rimraf .next && next dev --webpack",
		"clean": "rimraf .next out",
		"prebuild": "rimraf .next out",
		"build": "node scripts/generate-build-info.cjs && node scripts/update-sw-version.cjs && bash scripts/build-static-export.sh",
		"start": "next start",
		"lint": "BROWSERSLIST_IGNORE_OLD_DATA=1 eslint . --max-warnings=0",
		"license:check": "node scripts/check-dependency-licenses.cjs",
		"quality:shape": "BROWSERSLIST_IGNORE_OLD_DATA=1 node scripts/check-code-shape.cjs",
		"test": "vitest run",
		"test:system:pocketbase": "bash scripts/run-pocketbase-system-test.sh",
		"test:watch": "vitest",
		"typecheck": "bunx --no-install --package @typescript/native tsc --noEmit",
		"export": "next export",
		"deploy": "bash scripts/deploy-prod.sh",
		"deploy:dev": "bash scripts/deploy-dev.sh",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:debug": "playwright test --debug",
		"test:csp": "node scripts/verify-production-csp.cjs",
		"test:pwa": "node scripts/verify-production-pwa.cjs",
		"smoke": "bun tools/stagehand/smoke.ts",
		"audit": "bun audit --audit-level=high"
	},
	"dependencies": {
		"@dnd-kit/core": "6.3.1",
		"@dnd-kit/sortable": "10.0.0",
		"@dnd-kit/utilities": "3.2.2",
		"@radix-ui/react-dialog": "1.1.23",
		"@radix-ui/react-dropdown-menu": "2.1.24",
		"@radix-ui/react-icons": "1.3.2",
		"@radix-ui/react-switch": "1.3.7",
		"@radix-ui/react-tooltip": "1.2.16",
		"@sentry/browser": "10.70.0",
		"@tanstack/react-query": "5.101.4",
		"@tanstack/react-virtual": "3.14.9",
		"canvas-confetti": "1.9.4",
		"clsx": "2.1.1",
		"cmdk": "1.1.1",
		"date-fns": "4.4.0",
		"dexie": "4.4.4",
		"dexie-react-hooks": "4.4.0",
		"lucide-react": "1.31.0",
		"nanoid": "6.0.1",
		"next": "16.3.0",
		"next-themes": "0.4.6",
		"pocketbase": "0.27.1",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"recharts": "3.10.1",
		"sonner": "2.0.8",
		"tailwind-merge": "3.6.0",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@browserbasehq/stagehand": "^4.0.2",
		"@playwright/test": "^1.62.1",
		"@tailwindcss/postcss": "4.3.3",
		"@testing-library/dom": "10.4.1",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/react": "16.3.2",
		"@testing-library/user-event": "14.6.3",
		"@types/canvas-confetti": "1.9.0",
		"@types/node": "26.2.0",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"@typescript/native": "npm:typescript@7.0.2",
		"@vitejs/plugin-react": "6.0.5",
		"@vitest/coverage-v8": "4.1.10",
		"babel-plugin-react-compiler": "1.0.0",
		"eslint": "10.8.1",
		"eslint-config-next": "16.3.0",
		"eslint-plugin-react-hooks": "7.1.1",
		"fake-indexeddb": "6.2.5",
		"jsdom": "30.0.1",
		"postcss": "8.5.22",
		"rimraf": "6.1.3",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"typescript-eslint": "8.66.0",
		"vite": "8.2.1",
		"vitest": "4.1.10"
	},
	"workspaces": [
		"packages/*"
	],
	"overrides": {
		"@hono/node-server": ">=2.0.5",
		"body-parser": ">=2.3.0",
		"sharp": ">=0.35.0",
		"js-yaml": ">=4.1.1",
		"baseline-browser-mapping": "2.11.13",
		"caniuse-lite": "1.0.30001809",
		"esbuild": ">=0.25.0",
		"@radix-ui/react-dialog": "1.1.23",
		"nanoid": ">=3.3.17",
		"@isaacs/brace-expansion": ">=5.0.1",
		"brace-expansion": ">=5.0.8",
		"qs": ">=6.15.2",
		"minimatch": ">=3.1.3",
		"rollup": ">=4.59.0",
		"hono": "4.13.0",
		"undici": "7.29.0",
		"vite": ">=8.2.1",
		"@babel/core": ">=8.0.1",
		"@opentelemetry/core": ">=2.9.0",
		"flatted": ">=3.4.2",
		"express-rate-limit": ">=8.2.2",
		"path-to-regexp": ">=8.4.0",
		"picomatch": ">=4.0.4",
		"fast-uri": "4.1.2",
		"ip-address": "10.4.0",
		"postcss": ">=8.5.14",
		"typescript-eslint": "8.66.0"
	},
	"license": "MIT"
}
