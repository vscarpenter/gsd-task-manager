{
	"name": "gsd-taskmanager",
	"version": "13.9.2",
	"packageManager": "bun@1.3.14",
	"private": true,
	"type": "module",
	"engines": {
		"node": "^22.22.2 || ^24.15.0 || >=26.0.0"
	},
	"scripts": {
		"dev": "next dev",
		"dev:e2e": "rimraf .next && next dev --webpack",
		"clean": "rimraf .next out",
		"prebuild": "rimraf .next out",
		"build": "node scripts/generate-build-info.cjs && bash scripts/build-static-export.sh",
		"start": "next start",
		"lint": "BROWSERSLIST_IGNORE_OLD_DATA=1 eslint . --max-warnings=0",
		"license:check": "node scripts/check-dependency-licenses.cjs",
		"quality:shape": "BROWSERSLIST_IGNORE_OLD_DATA=1 node scripts/check-code-shape.cjs",
		"quality:bundle": "node scripts/check-bundle-budget.cjs",
		"knip": "knip --production --files --dependencies",
		"test": "vitest run",
		"test:system:pocketbase": "bash scripts/run-pocketbase-system-test.sh",
		"test:watch": "vitest",
		"typecheck": "bunx --no-install --package @typescript/native tsc --noEmit",
		"export": "next export",
		"deploy": "bash scripts/deploy-prod.sh",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:debug": "playwright test --debug",
		"test:e2e:export": "playwright test --config playwright.export.config.ts",
		"test:csp": "node scripts/verify-production-csp.cjs",
		"test:pwa": "node scripts/verify-production-pwa.cjs",
		"smoke": "bun tools/stagehand/smoke.ts",
		"audit": "bun audit --audit-level=high"
	},
	"dependencies": {
		"@dnd-kit/core": "6.3.1",
		"@dnd-kit/sortable": "10.0.0",
		"@dnd-kit/utilities": "3.2.2",
		"@radix-ui/react-dialog": "1.1.23",
		"@radix-ui/react-dropdown-menu": "2.1.24",
		"@radix-ui/react-icons": "1.3.2",
		"@radix-ui/react-switch": "1.3.7",
		"@radix-ui/react-tooltip": "1.2.16",
		"@tanstack/react-query": "5.104.0",
		"@tanstack/react-virtual": "3.14.13",
		"canvas-confetti": "1.9.4",
		"clsx": "2.1.1",
		"cmdk": "1.1.1",
		"date-fns": "4.4.0",
		"dexie": "4.4.6",
		"dexie-react-hooks": "4.4.0",
		"lucide-react": "1.48.0",
		"nanoid": "6.0.1",
		"next": "16.3.8",
		"next-themes": "0.4.6",
		"pocketbase": "0.28.1",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"recharts": "3.10.1",
		"sonner": "2.0.8",
		"tailwind-merge": "3.7.0",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@browserbasehq/stagehand": "^4.2.0",
		"@playwright/test": "^1.64.0",
		"@tailwindcss/postcss": "4.3.3",
		"@testing-library/dom": "10.4.2",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/react": "16.3.3",
		"@testing-library/user-event": "14.6.7",
		"@types/canvas-confetti": "1.9.0",
		"@types/node": "26.6.3",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@typescript/native": "npm:typescript@7.0.2",
		"@vitejs/plugin-react": "6.1.1",
		"@vitest/coverage-v8": "5.0.2",
		"babel-plugin-react-compiler": "1.0.0",
		"eslint": "10.11.0",
		"eslint-config-next": "16.3.8",
		"eslint-plugin-react-hooks": "7.1.1",
		"fake-indexeddb": "6.2.5",
		"jsdom": "30.0.1",
		"knip": "6.40.0",
		"postcss": "8.5.28",
		"rimraf": "6.1.3",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"typescript-eslint": "8.66.0",
		"vite": "8.3.1",
		"vitest": "5.0.2"
	},
	"workspaces": [
		"packages/*"
	],
	"overrides": {
		"@babel/core": ">=8.0.6",
		"@hono/node-server": ">=2.1.3",
		"@isaacs/brace-expansion": ">=5.0.1",
		"@opentelemetry/core": ">=2.11.0",
		"@radix-ui/react-dialog": "1.1.23",
		"baseline-browser-mapping": "2.11.13",
		"body-parser": ">=2.3.0",
		"brace-expansion": ">=5.0.12",
		"browserslist": ">=4.29.3",
		"caniuse-lite": "1.0.30001809",
		"esbuild": ">=0.28.2",
		"express-rate-limit": ">=8.7.0",
		"fast-uri": "4.1.5",
		"flatted": ">=3.4.4",
		"hono": "4.13.7",
		"ip-address": "10.7.2",
		"js-yaml": ">=5.4.2",
		"minimatch": ">=10.2.6",
		"nanoid": ">=6.0.1",
		"path-to-regexp": ">=8.4.2",
		"picomatch": ">=4.0.7",
		"postcss": ">=8.5.28",
		"proxy-addr": ">=2.0.8",
		"qs": ">=6.16.0",
		"rollup": ">=4.63.5",
		"sharp": "0.35.5",
		"source-map-js": ">=1.2.2",
		"typescript-eslint": "8.66.0",
		"undici": "7.29.1",
		"vite": ">=8.3.1"
	},
	"license": "MIT"
}
